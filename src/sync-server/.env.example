# Go sync-server の環境変数の例。config.FromEnv()（internal/config/config.go）が読む。
# .env を自動で読み込む仕組みは無いので、実行前に環境変数として export すること
# （例: `set -a; source .env; set +a`）。

# development | production。必須。development以外の値は起動時に例外
SYNC_SERVER_ENV=development

# リッスンアドレス。未設定なら PORT、それも無ければ :8080
SYNC_SERVER_ADDR=
PORT=

# シャード数。未設定なら1
SYNC_SERVER_SHARD_COUNT=

# CORS/WebSocketのCheckOriginで許可するオリジン（カンマ区切り）。
# development で未設定の場合は、同一Host（Origin のホストとリクエスト先ホストが
# 一致）へフォールバックする
SYNC_SERVER_ALLOWED_ORIGINS=

# development限定。Codespacesの転送URL（<codespace-name>-<port>.<この値>）越しに
# フロントを開いたときのオリジンを追加で許可する（internal/originmatch）。
# フロント（NEXT_PUBLIC_CODESPACES_FORWARDING_DOMAIN）・Rails
# （CODESPACES_FORWARDING_DOMAIN）と同じ変数名・同じ値を使うこと。
# CODESPACE_NAME はCodespaces自身が設定するので、ここで指定する必要はない。
# 本番の環境変数には設定しないこと
CODESPACES_FORWARDING_DOMAIN=app.github.dev

# ノードID。未設定ならホスト名（取得できなければ sync-server-local）。
# questboard-rails-backend は予約済み（Railsのリレー用オリジンと衝突するため使用不可）
SYNC_SERVER_NODE_ID=

# Redis（本番のマルチノード配信で使用）
SYNC_SERVER_REDIS_URL=
SYNC_SERVER_REDIS_CHANNEL_PREFIX=questboard:sync
SYNC_SERVER_REDIS_POOL_SIZE=

# 本番でWebSocket接続時にRails側へ認証・認可・永続化を委譲する際のベースURL
SYNC_SERVER_BACKEND_URL=http://localhost:3000
