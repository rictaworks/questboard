<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>KPI開発者ダッシュボード</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f6f7fb;
        --panel: #ffffff;
        --border: #dbe1ee;
        --text: #13213c;
        --muted: #5e6b84;
        --accent: #3b82f6;
        --track: #e7ecf5;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      main {
        max-width: 1120px;
        margin: 0 auto;
        padding: 32px 20px 40px;
      }

      .hero {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: end;
        justify-content: space-between;
        margin-bottom: 20px;
      }

      .eyebrow {
        margin: 0 0 8px;
        color: var(--accent);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .08em;
      }

      h1, h2, p { margin: 0; }

      h1 {
        font-size: 28px;
        line-height: 1.2;
      }

      .footnote {
        margin-top: 8px;
        color: var(--muted);
        font-size: 13px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }

      .tile, .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 12px 36px rgba(20, 33, 61, .06);
      }

      .tile {
        padding: 18px;
      }

      .tile-label, .panel-label {
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .tile-value {
        margin-top: 14px;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -.03em;
      }

      .tile-subvalue {
        margin-top: 8px;
        color: var(--muted);
        font-size: 14px;
      }

      .panel {
        margin-top: 16px;
        padding: 18px;
      }

      .panel h2 {
        font-size: 18px;
      }

      .bars {
        margin-top: 16px;
        display: grid;
        gap: 12px;
      }

      .bar-row {
        display: grid;
        grid-template-columns: 92px minmax(0, 1fr) 76px;
        gap: 12px;
        align-items: center;
      }

      .bar-track {
        position: relative;
        height: 12px;
        border-radius: 999px;
        background: var(--track);
        overflow: hidden;
      }

      .bar-fill {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #60a5fa, #2563eb);
      }

      .bar-value {
        text-align: right;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      @media (max-width: 640px) {
        .bar-row {
          grid-template-columns: 1fr;
        }

        .bar-value {
          text-align: left;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
