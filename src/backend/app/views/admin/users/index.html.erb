<style>
  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
  }

  .btn-primary:hover {
    background: #2563eb;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
  }

  .btn-secondary {
    background: #e7ecf5;
    color: var(--text);
  }

  .btn-secondary:hover {
    background: #dbe1ee;
  }

  .btn-danger {
    background: #ef4444;
    color: white;
  }

  .btn-success {
    background: #10b981;
    color: white;
  }

  .form-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 12px 36px rgba(20, 33, 61, .04);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) auto;
    gap: 16px;
    align-items: end;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }

  .form-control {
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-control:focus {
    border-color: var(--accent);
  }

  .table-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 12px 36px rgba(20, 33, 61, .04);
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  th {
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    border-bottom: 2px solid var(--border);
  }

  td {
    padding: 16px;
    font-size: 14px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  tr:last-child td {
    border-bottom: none;
  }

  .badge {
    display: inline-flex;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 6px;
    text-transform: uppercase;
  }

  .badge-member {
    background: #d1fae5;
    color: #065f46;
  }

  .badge-none {
    background: #f3f4f6;
    color: #374151;
  }

  .flash {
    padding: 12px 16px;
    border-radius: 12px;
    margin-bottom: 20px;
    font-size: 14px;
    font-weight: 600;
  }

  .flash-notice {
    background: #d1fae5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .flash-alert {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }
</style>

<div class="admin-header">
  <div>
    <p class="eyebrow">管理ダッシュボード</p>
    <h1>利用者一覧</h1>
  </div>
  <%= link_to "KPIダッシュボードへ戻る", admin_root_path, class: "btn btn-secondary" %>
</div>

<% if flash[:notice] %>
  <div class="flash flash-notice"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="flash flash-alert"><%= flash[:alert] %></div>
<% end %>

<div class="table-panel">
  <h2>登録済みユーザー一覧</h2>
  <p class="footnote" style="margin-bottom: 16px;">最新の登録・更新ユーザー50件を表示しています。特定のユーザーは以下の検索フォームから検索できます。</p>
  <p class="footnote" style="margin-bottom: 16px;">プラン値はフォロワー判定サービスの判定をそのまま写したものです。個別の許可・拒否（オーバーライド）は判定サービスの管理画面で登録します。</p>

  <div style="margin-bottom: 16px;">
    <%= form_with url: admin_users_path, method: :get, local: true, class: "form-grid", style: "grid-template-columns: minmax(200px, 1fr) auto auto; gap: 8px;" do |f| %>
      <div class="form-group" style="gap: 0; margin-bottom: 0;">
        <%= f.text_field :search_user, value: params[:search_user], class: "form-control", placeholder: "表示名、または X ユーザーIDで検索...", style: "width: 100%;" %>
      </div>
      <%= f.submit "検索", class: "btn btn-primary" %>
      <%= link_to "クリア", admin_users_path, class: "btn btn-secondary" %>
    <% end %>
  </div>

  <table>
    <thead>
      <tr>
        <th>表示名</th>
        <th>X ユーザーID</th>
        <th>現在のプラン</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><strong><%= user.display_name %></strong></td>
          <td><code><%= user.x_user_id %></code></td>
          <td>
            <% if user.plan == @member_plan %>
              <span class="badge badge-member">MEMBER</span>
            <% else %>
              <span class="badge badge-none">NONE</span>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @users.empty? %>
        <tr>
          <td colspan="3" style="text-align: center; color: var(--muted); padding: 32px;">
            登録されているユーザーはいません。
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
