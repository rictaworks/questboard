# フロントエンド（Next.js）の環境変数の例。
# バックエンド（Rails）側は src/backend/.env.example を参照すること。
#
# NEXT_PUBLIC_ 接頭辞の値はビルド成果物に埋め込まれ、ブラウザから読める。
# 秘密情報（クライアントシークレット・APIキー・master.key 等）をここに置いてはならない。

# バックエンドAPIのベースURL（末尾のスラッシュは付けない）
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Codespacesの転送URL（<codespace-name>-<port>.<この値>）越しに開いたときだけ、
# development環境限定で NEXT_PUBLIC_BACKEND_URL の localhost をこのドメイン上の
# バックエンド転送URLへ動的に置き換える（src/lib/backend-url.ts）。
# 本番（Vercel）では参照されないので、本番の .env には設定しないこと
NEXT_PUBLIC_CODESPACES_FORWARDING_DOMAIN=app.github.dev

# X OAuth 2.0 のクライアントID（公開値）
NEXT_PUBLIC_X_CLIENT_ID=

# X OAuth のリダイレクト先。X 側のアプリ設定と完全一致させる
NEXT_PUBLIC_X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# reCAPTCHA v3 のサイトキー（公開値）
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Go sync-server の WebSocket URL。未設定だとボードのリアルタイム同期が例外になる
NEXT_PUBLIC_SYNC_SERVER_URL=ws://localhost:8080

# Sentry の DSN（公開値）。未設定ならクライアント側のエラー送信を行わない
NEXT_PUBLIC_SENTRY_DSN=

# 利用不可画面のフォロー案内で表示する対象アカウントのハンドル（先頭の @ は任意）。
# バックエンドの X_FOLLOWER_GATE_TARGET_ACCOUNT_ID は数値IDでハンドルを含まないため、
# 表示用の値をここに別途持つ。両者が別のアカウントを指すと案内が誤りになる。
NEXT_PUBLIC_X_FOLLOW_TARGET_HANDLE=rictaworks

# 環境判定。development のとき認証済みとして分岐する（本番UIには露出しない）
NEXT_PUBLIC_ENV=development

# /board-layout-fixture（Playwrightレイアウト回帰テスト用の固定表示ページ）を
# development 以外のビルドでも公開するかどうか。CIのみ true を設定し、
# 本番デプロイでは未設定のままにして一般公開を防ぐこと
NEXT_PUBLIC_ENABLE_LAYOUT_FIXTURE=
